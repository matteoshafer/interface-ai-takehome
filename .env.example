# Copy to .env and fill in. Only `cua discover` (the LLM run) needs a key;
# replay, catalog, operator, and the whole test suite run without one.

# Anthropic API key for the LLM-driven discovery run.
# Create one at https://console.anthropic.com  ->  Settings  ->  API Keys  ->  Create Key
ANTHROPIC_API_KEY=

# Model used for discovery. Replay never calls a model.
CUA_DISCOVERY_MODEL=claude-sonnet-5

# Mock app address (used by `--serve-mock` and as the default discovery target).
CUA_MOCKAPP_URL=http://localhost:5050

# Operator console port (human-in-the-loop handoff).
CUA_OPERATOR_PORT=5051

# Optional: credentials the agent types into the mock app's login screen.
# The mock accepts any non-empty pair; these default to operator / demo-pass.
CUA_APP_USERNAME=operator
CUA_APP_PASSWORD=demo-pass

# Optional: path to a Chromium-family browser if Playwright's own download fails.
# CUA_BROWSER_PATH=/Applications/Brave Browser.app/Contents/MacOS/Brave Browser
