# Copy to .env and fill in. Only `cua discover` (the LLM run) needs a key;
# replay, catalog, operator, and the whole test suite run without one.

# --- LLM provider for the discovery run (pick ONE) ---------------------------
# The loop auto-detects the provider from whichever key is set; override with
# --provider or CUA_LLM_PROVIDER. Replay never calls a model.

# Claude:  https://console.anthropic.com  ->  Settings  ->  API Keys
ANTHROPIC_API_KEY=

# NVIDIA NIM (build.nvidia.com -- has trial credits):
#   https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=

# OpenAI (or any other OpenAI-compatible endpoint):
# OPENAI_API_KEY=

# Optional overrides:
# CUA_LLM_PROVIDER=nvidia               # force a provider
# CUA_DISCOVERY_MODEL=meta/llama-3.3-70b-instruct
# CUA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# CUA_LLM_TOOL_CHOICE=required          # or "auto" if a model rejects "required"

# --- Mock app / operator console -------------------------------------------
CUA_MOCKAPP_URL=http://localhost:5050
CUA_OPERATOR_PORT=5051

# Credentials the agent types into the mock app's login screen (any non-empty
# pair works; these are the defaults).
CUA_APP_USERNAME=operator
CUA_APP_PASSWORD=demo-pass

# Optional: a Chromium-family browser if Playwright's own download fails.
# CUA_BROWSER_PATH=/Applications/Brave Browser.app/Contents/MacOS/Brave Browser
